{
  "name": "genie-react",
  "version": "0.12.6",
  "type": "module",
  "description": "Live React and TanStack DevTools for AI coding agents. Find performance problems, test app states, and verify fixes end to end.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genie-sa/genie-react.git",
    "directory": "packages/genie-react"
  },
  "homepage": "https://github.com/Genie-sa/genie-react#readme",
  "bugs": "https://github.com/Genie-sa/genie-react/issues",
  "keywords": [
    "react",
    "react-devtools",
    "react-performance",
    "react-profiler",
    "tanstack-query",
    "tanstack-router",
    "vite",
    "nextjs",
    "react-native",
    "ai-agent",
    "developer-tools",
    "debugging"
  ],
  "author": "y0u-0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "import": "./dist/hook.js",
      "default": "./dist/hook.js"
    },
    "./hook-hmr": {
      "types": "./dist/hook-hmr.d.ts",
      "import": "./dist/hook-hmr.js",
      "default": "./dist/hook-hmr.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./collectors": {
      "types": "./dist/collectors.d.ts",
      "import": "./dist/collectors.js",
      "default": "./dist/collectors.js"
    },
    "./collectors/query": {
      "types": "./dist/collectors/query.d.ts",
      "import": "./dist/collectors/query.js",
      "default": "./dist/collectors/query.js"
    },
    "./collectors/router": {
      "types": "./dist/collectors/router.d.ts",
      "import": "./dist/collectors/router.js",
      "default": "./dist/collectors/router.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js",
      "default": "./dist/script.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "import": "./dist/hub.js",
      "default": "./dist/hub.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./package.json": "./package.json",
    "./babel": {
      "import": {
        "types": "./dist/babel.d.mts",
        "default": "./dist/babel.mjs"
      },
      "require": {
        "types": "./dist/babel.d.cts",
        "default": "./dist/babel.cjs"
      }
    },
    "./react-freeze": {
      "types": "./dist/react-freeze.d.ts",
      "import": "./dist/react-freeze.js",
      "default": "./dist/react-freeze.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bippy": "0.7.2",
    "superjson": "^2.2.6",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0",
    "@tanstack/react-query": ">=5",
    "@tanstack/react-router": ">=1",
    "react": ">=18",
    "vite": ">=5",
    "react-freeze": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@babel/core": {
      "optional": true
    },
    "react-freeze": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.0",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "jsdom": "^28.1.0",
    "react": "^19.2.7",
    "react-freeze": "1.0.4",
    "vite": "^8.1.0"
  }
}
