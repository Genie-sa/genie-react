{
  "name": "@genie-react/cli",
  "version": "1.1.0",
  "description": "Let your coding agent verify and optimize your React and React Native apps: see what rendered and why, and prove each fix worked. This is the command your agent runs; add genie-react to your app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genie-sa/genie-react.git",
    "directory": "packages/cli"
  },
  "homepage": "https://genie-react.com",
  "bugs": "https://github.com/Genie-sa/genie-react/issues",
  "keywords": [
    "react",
    "react-devtools",
    "react-performance",
    "tanstack-query",
    "tanstack-router",
    "ai-agent",
    "coding-agent",
    "claude-code",
    "codex",
    "vite",
    "nextjs",
    "debugging",
    "json",
    "cli"
  ],
  "author": "y0u-0",
  "type": "module",
  "bin": {
    "genie-react": "./bin/genie-react.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "genie-react": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.0"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "genie-react": "./dist/cli.js"
    }
  }
}
