{
  "name": "genie-react-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Genie — give an AI coding agent full DevTools access to your live React + TanStack app from your terminal via the genie CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genie-sa/genie-react.git"
  },
  "author": "y0u-0",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/**\" dev",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck && tsrs -p evals",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node evals/run.mjs",
    "lint": "biome check . && node scripts/check-comments.mjs && node scripts/check-cli-ux.mjs && node scripts/sync-skill.mjs --check",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:docs": "pnpm --filter @genie-react/docs check",
    "test:e2e": "node scripts/check-vite-e2e.mjs && node scripts/check-suspense-e2e.mjs",
    "check:e2e": "pnpm build && pnpm test:e2e",
    "test:apps-e2e": "node scripts/check-apps-e2e.mjs",
    "check:apps-e2e": "pnpm build && pnpm test:apps-e2e",
    "test:compatibility": "node scripts/check-compatibility.mjs",
    "check:compatibility": "pnpm build && pnpm test:compatibility",
    "test:react18": "node scripts/check-react18-corpus.mjs",
    "test:babel8": "node scripts/check-babel-8.mjs",
    "test:effect-e2e": "node scripts/check-effect-e2e.mjs",
    "test:parallel-agents": "node scripts/check-parallel-agents.mjs",
    "test:agent-browser": "node scripts/check-agent-browser-e2e.mjs",
    "check:runtime-overhead": "pnpm --filter genie-react build && node scripts/benchmark-runtime-overhead.mjs --guard",
    "check:release": "node scripts/sync-skill.mjs --check && node scripts/prepare-release.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm check:release && pnpm test && pnpm check:docs",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-skill.mjs",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.6.4",
    "gpt-tokenizer": "4.1.2",
    "pkg-pr-new": "^0.0.91",
    "playwright": "^1.63.0",
    "tsdown": "^0.22.3",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
