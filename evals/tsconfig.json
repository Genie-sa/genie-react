{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "run.mjs",
    "lib/**/*.mjs",
    "lib/**/*.ts",
    "realworld/run-probes.mjs",
    "realworld/run-spec-probes.mjs",
    "realworld/lib/**/*.mjs",
    "realworld/lib/**/*.ts",
    "realworld/dashboard/**/*.mjs",
    "realworld/dashboard/**/*.ts"
  ]
}
